# ----------- DESTINATION -----------

BASE_URL=""https://stage.foo.redhat.com:1337"       # This is the base URL for the environment you are testing against (local / stage / prod)  
PROXY=""                                            # Set this if running directly against stage (not using 'yarn local' or 'yarn start:stage')

# ----------- ENVIRONMENT -----------

CI=""                                               # This is set to true for CI jobs, if checking for CI do !!process.env.CI
INTEGRATION=""                                      # When this is true, playwright test will run integration tests
PROD=""                                             # When this and $INTEGRATION is set to true, integration tests will run those meant for production

# -------------- OTHER --------------

TOKEN=""                                            # This is handled programmatically
