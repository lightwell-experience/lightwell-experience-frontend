{
  "name": "lightwell-network-ui-frontend",
  "version": "1.0.0",
  "private": false,
  "engines": {
    "node": ">=18.20.8",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "build": "fec build",
    "build:prod": "yarn build",
    "deploy": "yarn build && yarn lint && yarn test",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint --fix 'src/**/*.{js,jsx,ts,tsx}'",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,scss,md}' --config ./.prettierrc",
    "format:check": "prettier --check 'src/**/*.{js,jsx,ts,tsx,css,scss,md}' --config ./.prettierrc",
    "patch:hosts": "fec patch-etc-hosts",
    "start": "fec dev",
    "start:stage": "fec dev --clouddotEnv=stage",
    "start:prod": "fec dev --clouddotEnv=prod",
    "start:verbose": "VERBOSE=true fec dev",
    "local": "BACKEND_PORT=8000 yarn start",
    "static": "fec static",
    "test": "jest",
    "postinstall": "ts-patch install && rimraf .cache",
    "verify": "yarn build && yarn lint && yarn format:check && yarn test"
  },
  "dependencies": {
    "@patternfly/react-component-groups": "^6.7.0",
    "@patternfly/react-core": "^6.6.1",
    "@patternfly/react-data-view": "^6.5.0",
    "@patternfly/react-drag-drop": "^6.6.2",
    "@patternfly/react-icons": "^6.6.1",
    "@patternfly/react-table": "^6.6.1",
    "@patternfly/react-tokens": "^6.6.1",
    "@redhat-cloud-services/frontend-components": "^7.10.12",
    "@redhat-cloud-services/frontend-components-utilities": "^7.3.1",
    "@scalprum/react-core": "^0.13.3",
    "@tanstack/react-query": "^5.103.2",
    "axios": "^1.20.0",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-content-loader": "^6.2.1",
    "react-dom": "^18.3.1",
    "react-redux": "^9.0.0",
    "react-router-dom": "^6.30.4 <6.30.5"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@redhat-cloud-services/frontend-components-config": "^6.10.0",
    "@redhat-cloud-services/tsc-transform-imports": "^1.1.1",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^14.3.1",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.0",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.70.1",
    "@typescript-eslint/parser": "^8.59.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.12.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.9",
    "rimraf": "^5.0.10",
    "ts-jest": "^29.4.9",
    "ts-patch": "^3.3.0",
    "typescript": "^5.9.3"
  },
  "insights": {
    "appname": "lightwell-network-ui"
  }
}
