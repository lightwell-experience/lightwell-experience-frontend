{
  "name": "lightwell-experience-frontend",
  "version": "1.0.0",
  "private": false,
  "engines": {
    "node": ">=18.20.8",
    "yarn": ">=1.22.0"
  },
  "scripts": {
    "build": "fec build",
    "build:prod": "yarn build",
    "deploy": "yarn build && yarn lint && yarn test",
    "lint": "eslint 'src/**/*.{js,jsx,ts,tsx}'",
    "lint:fix": "eslint --fix 'src/**/*.{js,jsx,ts,tsx}'",
    "format": "prettier --write 'src/**/*.{js,jsx,ts,tsx,css,scss,md}' --config ./.prettierrc",
    "format:check": "prettier --check 'src/**/*.{js,jsx,ts,tsx,css,scss,md}' --config ./.prettierrc",
    "patch:hosts": "fec patch-etc-hosts",
    "start": "fec dev",
    "start:stage": "fec dev --clouddotEnv=stage",
    "start:prod": "fec dev --clouddotEnv=prod",
    "start:verbose": "VERBOSE=true fec dev",
    "local": "BACKEND_PORT=8000 yarn start",
    "static": "fec static",
    "test": "jest",
    "postinstall": "ts-patch install && rimraf .cache",
    "verify": "yarn build && yarn lint && yarn format:check && yarn test"
  },
  "dependencies": {
    "@patternfly/react-component-groups": "^6.7.0",
    "@patternfly/react-core": "^6.7.0",
    "@patternfly/react-data-view": "^6.7.0",
    "@patternfly/react-drag-drop": "^6.7.0",
    "@patternfly/react-icons": "^6.6.1",
    "@patternfly/react-table": "^6.6.1",
    "@patternfly/react-tokens": "^6.6.1",
    "@redhat-cloud-services/frontend-components": "^7.10.15",
    "@redhat-cloud-services/frontend-components-utilities": "^7.5.11",
    "@scalprum/react-core": "^0.14.1",
    "@tanstack/react-query": "^5.104.4",
    "@unleash/proxy-client-react": "^6.0.1",
    "axios": "^1.20.0",
    "lodash": "^4.18.1",
    "react": "^18.3.1",
    "react-content-loader": "^7.1.2",
    "react-dom": "^18.3.1",
    "react-redux": "^9.0.0",
    "react-router-dom": "^6.30.4 <6.30.5",
    "unleash-proxy-client": "^3.8.2"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@redhat-cloud-services/frontend-components-config": "^6.14.15",
    "@redhat-cloud-services/tsc-transform-imports": "^1.3.11",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@types/jest": "^29.5.14",
    "@types/lodash": "^4.17.26",
    "@types/react": "^18.3.28",
    "@types/react-dom": "^18.3.7",
    "@typescript-eslint/eslint-plugin": "^8.71.2",
    "@typescript-eslint/parser": "^8.71.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^17.13.0",
    "identity-obj-proxy": "^3.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "ts-jest": "^29.4.15",
    "ts-patch": "^3.3.0",
    "typescript": "^5.9.3"
  },
  "insights": {
    "appname": "lightwell-experience"
  }
}
